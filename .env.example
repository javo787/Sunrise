# ───────── Основное ─────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net
MONGODB_DB=sunrise
PUBLIC_BASE_URL=https://sunrise-crm.example.com
TIMEZONE=Asia/Dushanbe
# Секрет для /api/cron/[job] (минимум 16 символов). Без него HTTP-эндпоинт cron закрыт.
CRON_SECRET=
# off — отключить встроенный node-cron (если задачи запускает внешний планировщик)
ENABLE_INTERNAL_CRON=on
# Через сколько минут неразобранный лид эскалируется (по ТЗ — 15)
ESCALATION_MINUTES=15
# self — лид, введённый менеджером вручную, закрепляется за ним; pool — идёт в общую группу
MANUAL_LEADS_ASSIGN=self
# Сколько реплик клиента ждать до передачи менеджеру, если анкета не добрана
AI_MAX_USER_TURNS=8
# Окно склейки сообщений клиента, мс
BATCH_DEBOUNCE_MS=6000

# ───────── Telegram ─────────
TELEGRAM_BOT_TOKEN=
# 16–256 символов: латиница, цифры, _ и -
TELEGRAM_WEBHOOK_SECRET=
# ID группы менеджеров (отрицательное число, узнать: /whoami в группе)
TELEGRAM_MANAGERS_CHAT_ID=
# ID руководителей через запятую — им доступны /addmanager, /report; их тегает эскалация
TELEGRAM_ADMIN_IDS=
# Куда слать отчёты (по умолчанию — в группу менеджеров)
TELEGRAM_REPORT_CHAT_ID=

# ───────── WhatsApp (Evolution API) ─────────
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sunrise
# Рекомендуется: общий секрет вебхука. URL в Evolution: https://домен/api/whatsapp-webhook?secret=<значение>
WHATSAPP_WEBHOOK_SECRET=

# ───────── Meta (лид-формы FB/IG и Instagram Direct) ─────────
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

# ───────── ИИ ─────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Бесплатный тариф AI Studio: у каждой модели свой лимит запросов, поэтому цепочка запасных моделей
# даёт больше «бесплатных» запросов. Проверьте доступные модели в AI Studio и при необходимости замените.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK_1=gemini-2.5-flash-lite
# GEMINI_MODEL_FALLBACK_2=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# ───────── Google Sheets ─────────
# JSON сервисного аккаунта целиком (или в base64). Дайте аккаунту доступ «Редактор» к таблице.
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_SPREADSHEET_ID=
SHEETS_HEADER_ROW=1
# Заголовки колонок, если отличаются от значений по умолчанию (см. README):
# SHEETS_COLUMNS={"name":"Имя клиента","phone":"Телефон","source":"Источник","stage":"Стадия"}
SHEETS_DATE_FORMAT=dd.MM.yyyy
SHEETS_SYNC_MAX_ATTEMPTS=10

# ───────── Почта для отчётов (необязательно) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sunrise CRM <crm@example.com>"
REPORT_EMAIL_TO=boss@example.com
